{
  "lexicon": 1,
  "id": "new.flock.ext.tasks.comment",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "body", "createdAt"],
        "properties": {
          "subject": { "type": "string", "format": "at-uri" },
          "body": { "type": "string", "minLength": 1, "maxLength": 40000, "maxGraphemes": 10000 },
          "createdAt": { "type": "string", "format": "datetime" },
          "editedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
