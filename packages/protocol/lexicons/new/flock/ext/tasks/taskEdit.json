{
  "lexicon": 1,
  "id": "new.flock.ext.tasks.taskEdit",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "t", "s"],
        "properties": {
          "subject": { "type": "string", "format": "at-uri" },
          "t": { "type": "string", "minLength": 20, "maxLength": 20 },
          "s": { "type": "array", "maxLength": 256, "items": { "type": "string", "minLength": 32, "maxLength": 32 } },
          "sTruncated": { "type": "boolean" },
          "title": { "type": "string", "minLength": 1, "maxLength": 1200, "maxGraphemes": 300 },
          "description": { "type": "string", "minLength": 1, "maxLength": 40000, "maxGraphemes": 10000 },
          "clearDescription": { "type": "boolean" },
          "status": { "type": "string", "enum": ["backlog", "todo", "in_progress", "done", "canceled"] },
          "priority": { "type": "string", "enum": ["none", "low", "medium", "high", "urgent"] },
          "project": { "type": "string", "format": "at-uri" },
          "clearProject": { "type": "boolean" },
          "dueDate": { "type": "string", "format": "datetime" },
          "clearDueDate": { "type": "boolean" },
          "parent": { "type": "string", "format": "at-uri" },
          "clearParent": { "type": "boolean" },
          "addAssignees": { "type": "array", "minLength": 1, "maxLength": 32, "items": { "type": "string", "format": "did" } },
          "removeAssignees": { "type": "array", "minLength": 1, "maxLength": 32, "items": { "type": "string", "format": "did" } },
          "addLabels": { "type": "array", "minLength": 1, "maxLength": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128, "maxGraphemes": 32 } },
          "removeLabels": { "type": "array", "minLength": 1, "maxLength": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128, "maxGraphemes": 32 } },
          "deleted": { "type": "boolean" }
        }
      }
    }
  }
}
