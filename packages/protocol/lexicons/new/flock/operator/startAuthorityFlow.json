{
  "lexicon": 1,
  "id": "new.flock.operator.startAuthorityFlow",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Issues a single-use, two-minute ticket for the caller to create a new opensocial.group account (prompt=create) or reauthorize the operator's shared group-DID session as an active effective human admin.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["purpose"],
          "properties": {
            "purpose": { "type": "string", "knownValues": ["createWorkspace", "reauthorize"] },
            "name": { "type": "string", "minLength": 1, "maxLength": 640, "maxGraphemes": 64, "description": "The group display name, for purpose createWorkspace." },
            "authority": { "type": "string", "format": "did", "description": "Existing group DID to reauthorize or complete workspace provisioning on." },
            "joinPolicy": { "type": "string", "knownValues": ["open", "approval", "invite"] },
            "publicMeta": { "type": "boolean" },
            "creationKey": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } }
      },
      "errors": [{ "name": "Unauthorized" }]
    }
  }
}
