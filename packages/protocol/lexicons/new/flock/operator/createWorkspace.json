{
  "lexicon": 1,
  "id": "new.flock.operator.createWorkspace",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Provisions Flock workspace modality spaces (new.flock.workspace/self, new.flock.inbox/self, and general new.flock.channel) inside an opensocial.group account using the operator's shared group-DID grant.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "operationId"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 640,
              "maxGraphemes": 64
            },
            "operationId": {
              "type": "string",
              "format": "tid"
            },
            "authority": {
              "type": "string",
              "format": "did",
              "description": "The opensocial.group DID created or reauthorized through startAuthorityFlow."
            },
            "joinPolicy": {
              "type": "string",
              "knownValues": ["open", "approval", "invite"]
            },
            "publicMeta": {
              "type": "boolean"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["operationId", "workspace", "channel", "state", "completedSteps"],
          "properties": {
            "operationId": { "type": "string", "format": "tid" },
            "groupDid": { "type": "string", "format": "did" },
            "workspace": { "type": "string", "format": "space-ref" },
            "channel": { "type": "string", "format": "space-ref", "description": "The workspace's general channel." },
            "state": {
              "type": "string",
              "knownValues": ["queued", "running", "pending", "completed", "failed", "paused", "aborted_actor_revoked"]
            },
            "completedSteps": {
              "type": "array",
              "items": { "type": "string", "maxLength": 128 }
            },
            "takenOverBy": { "type": "string", "format": "did" },
            "error": { "type": "string", "maxLength": 1000 }
          }
        }
      },
      "errors": [
        { "name": "Unauthorized" },
        {
          "name": "AuthorizationRequired",
          "description": "The operator holds no usable shared session for this group DID: start the authority flow, then retry with the same operation id."
        },
        { "name": "OperationIdConflict" },
        { "name": "WorkspaceExists" },
        { "name": "Paused" },
        { "name": "Busy" }
      ]
    }
  }
}
