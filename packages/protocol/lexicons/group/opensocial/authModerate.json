{
  "lexicon": 1,
  "id": "group.opensocial.authModerate",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions. Limited to what the authorizing user's roles grant.",
      "title": "Group moderation",
      "detail": "Approve, invite, label, and remove members, change their roles, and review reports.",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.meta",
          "authority": "self",
          "skey": "self",
          "collection": ["com.atproto.label.record"],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.members",
          "authority": "self",
          "skey": "self",
          "collection": [
            "group.opensocial.membership",
            "com.atproto.label.record"
          ],
          "action": ["read", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.invites",
          "authority": "*",
          "skey": "self",
          "collection": ["group.opensocial.invite"],
          "action": ["read_self", "create", "update", "delete"]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "aud": "*",
          "lxm": [
            "group.opensocial.listJoinRequests",
            "group.opensocial.denyJoinRequest",
            "group.opensocial.listModSubjects",
            "group.opensocial.getModSubjectHistory",
            "group.opensocial.resolveModSubject"
          ]
        }
      ]
    }
  }
}
