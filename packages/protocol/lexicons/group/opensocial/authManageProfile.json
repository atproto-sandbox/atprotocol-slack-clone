        {
          "type": "permission",
          "resource": "space",
          "spaceType": "group.opensocial.meta",
          "authority": "self",
          "skey": "self",
          "collection": ["group.opensocial.profile", "group.opensocial.rule"],
          "action": ["read", "create", "update", "delete"]
        }
      ]
    }
  }
}
