{
  "lexicon": 1,
  "id": "group.opensocial.authManageProfile",
  "defs": {
    "main": {
      "type": "permission-set",
      "description": "For group-DID sessions. Limited to what the authorizing user's roles grant.",
      "title": "Group profile",
      "detail": "Edit the group's profile and rules.",
