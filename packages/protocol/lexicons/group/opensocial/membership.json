{
  "lexicon": 1,
  "id": "group.opensocial.membership",
  "defs": {
    "main": {
      "type": "record",
      "description": "A member's roles in the group, keyed by the member's DID. Written by the group in the members space, and paired with the member's acceptance.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["roles", "createdAt"],
        "properties": {
          "roles": {
            "type": "array",
            "maxLength": 100,
            "items": {
              "type": "string",
              "format": "record-key",
              "description": "A role record's key."
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
