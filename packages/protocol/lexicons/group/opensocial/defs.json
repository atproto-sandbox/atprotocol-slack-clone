{
  "lexicon": 1,
  "id": "group.opensocial.defs",
  "defs": {
    "modSubjectView": {
      "type": "object",
      "description": "A subject in the moderation queue.",
      "required": [
        "subject",
        "status",
        "createdAt",
        "updatedAt",
        "reportCount"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "format": "uri",
          "description": "An account DID or record URI."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "If set, a specific version of the record."
        },
        "status": {
          "type": "string",
          "enum": ["open", "escalated", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "updatedAt": {
          "type": "string",
          "format": "datetime"
        },
        "reportCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "moderationEvent": {
      "type": "object",
      "description": "An event in a subject's moderation history.",
      "required": ["id", "createdAt", "event"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "createdBy": {
          "type": "string",
          "format": "did",
          "description": "May be withheld to protect reporters and moderators."
        },
        "event": {
          "type": "union",
          "refs": [
            "group.opensocial.defs#reportEvent",
            "group.opensocial.defs#statusEvent",
            "group.opensocial.defs#labelEvent",
            "group.opensocial.defs#ejectEvent"
          ]
        }
      }
    },
    "reportEvent": {
      "type": "object",
      "description": "A report was filed.",
      "required": ["reasonType"],
      "properties": {
        "reasonType": {
          "type": "string",
          "knownValues": [
            "spam",
            "violation",
            "misleading",
            "nsfw",
            "rude",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        },
        "rule": {
          "type": "string",
          "format": "at-uri"
        }
      }
    },
    "statusEvent": {
      "type": "object",
      "description": "A moderator changed the subject's status or added a note.",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["open", "escalated", "resolved"]
        },
        "note": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        }
      }
    },
    "labelEvent": {
      "type": "object",
      "description": "A label record was written or deleted.",
      "required": ["uri", "val"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The label record."
        },
        "val": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deleted": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ejectEvent": {
      "type": "object",
      "description": "The subject was ejected from the group.",
      "properties": {}
    },
    "joinRequest": {
      "type": "object",
      "description": "A pending join request.",
      "required": ["member", "createdAt"],
      "properties": {
        "member": {
          "type": "string",
          "format": "did"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "message": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        }
      }
    }
  }
}
