{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/desk/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "apps/web/.next/types/**/*.ts",
    "apps/web/.next/dev/types/**/*.ts",
    "apps/desk/.next/types/**/*.ts",
    "apps/desk/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "protocol-tests"
  ]
}
