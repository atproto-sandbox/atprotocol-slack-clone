# --- Shared by the web app and the operator ---------------------------------------------------------------------
APP_URL=http://127.0.0.1:3000
# Where the operator serves its XRPC methods, its authority flow and its did:web document (its own process, own origin).
OPERATOR_URL=http://127.0.0.1:3001
# Public did:web service ref whose DID document (served by the operator at OPERATOR_URL) names the operator's endpoint.
# Quoted: unquoted, the "#" would start a comment.
OPERATOR_SERVICE_REF="did:web:localhost%3A3001#atproto_flock_operator"
PLC_URL=https://plc.directory

# --- The operator only (the web app holds no database and no secret) --------------------------------------------
DATABASE_PATH=./data/flock.db
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
# Set to true to refuse admin changes (workspace creation, operator mutations and their recovery) during maintenance.
FLOCK_ADMIN_MUTATIONS_PAUSED=false
# Required outside loopback development: the workspace-authority OAuth client's private signing keys, as a JSON JWK set
# {"keys":[...]} of EC P-256 keys with unique kids, newest first (the first signs; all are published for rotation).
# Generate a key with: pnpm authority generate-key <kid> (prints one private JWK; add it to the "keys" array). Rotation: docs/operations.md.
AUTHORITY_CLIENT_PRIVATE_JWKS=
# Optional, behind a proxy that terminates TLS: the port the operator listens on (by default OPERATOR_URL's own).
# PORT=
