APP_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/slack.db
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
PLC_URL=https://plc.directory
# Public did:web service ref whose DID document resolves to this app's operator endpoint.
OPERATOR_SERVICE_REF=did:web:localhost%3A3000#atproto_slack_admin
# Days a cached copy of a space stays after its account last read it. The cache is also purged on a lost credential, a removed
# member, and a space-deleted notice; this bounds what is kept for accounts that never return.
CACHE_RETENTION_DAYS=30
