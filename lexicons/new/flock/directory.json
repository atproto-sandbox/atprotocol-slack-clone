{
  "lexicon": 1,
  "id": "new.flock.directory",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["skey", "name", "visibility"],
        "properties": {
          "skey": { "type": "string", "format": "record-key", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 320, "maxGraphemes": 80 },
          "visibility": { "type": "string", "enum": ["public", "private", "transitioning", "archived"] }
        }
      }
    }
  }
}
