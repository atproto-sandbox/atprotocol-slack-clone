{
  "lexicon": 1,
  "id": "new.flock.permissions.member",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Member workspace access",
      "detail": "Read joined workspaces and channels, publish member-owned messages and requests, and write an acceptance marker.",
      "permissions": [
        { "type": "permission", "resource": "space", "spaceType": "new.flock.workspace", "authority": "*", "action": ["read"] },
        { "type": "permission", "resource": "space", "spaceType": "new.flock.channel", "authority": "*", "action": ["read"] },
        { "type": "permission", "resource": "space", "spaceType": "new.flock.workspace", "authority": "*", "collection": ["new.flock.acceptance"], "action": ["create", "update"] },
        { "type": "permission", "resource": "space", "spaceType": "new.flock.inbox", "authority": "*", "collection": ["new.flock.joinRequest"], "action": ["create", "update", "delete"] },
        { "type": "permission", "resource": "space", "spaceType": "new.flock.channel", "authority": "*", "collection": ["new.flock.channel.message", "new.flock.channel.reaction"], "action": ["create", "update", "delete"] }
      ]
    }
  }
}
