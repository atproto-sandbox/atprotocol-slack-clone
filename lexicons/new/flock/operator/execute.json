{
  "lexicon": 1,
  "id": "new.flock.operator.execute",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit an idempotent workspace administration operation. Caller identity is derived from the verified service-auth issuer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["workspace", "operationId", "request"],
          "properties": {
            "workspace": { "type": "string", "format": "space-ref" },
            "operationId": { "type": "string", "format": "tid" },
            "request": { "type": "ref", "ref": "#operationRequest" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "required": ["operation"], "properties": { "operation": { "type": "ref", "ref": "#operation" } } }
      },
      "errors": [{ "name": "Unauthorized" }, { "name": "Conflict" }, { "name": "Paused" }]
    },
    "operationRequest": {
      "type": "object",
      "description": "The server validates the required fields for each kind and rejects extra or missing fields.",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "knownValues": ["inviteMember", "removeMember", "setAdmin", "createChannel", "transitionChannel", "archiveChannel", "decideJoinRequest", "leaveWorkspace", "leaveChannel", "reconcileWorkspace"] },
        "subject": { "type": "string", "format": "did" },
        "active": { "type": "boolean" },
        "skey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visibility": { "type": "string", "knownValues": ["public", "private"] },
        "members": { "type": "array", "items": { "type": "string", "format": "did" }, "maxLength": 200 },
        "request": { "type": "string", "format": "at-uri" },
        "requestId": { "type": "string", "format": "tid" },
        "decision": { "type": "string", "knownValues": ["approve", "deny"] }
      }
    },
    "operation": {
      "type": "object",
      "required": ["operationId", "requestHash", "state", "completedSteps", "updatedAt"],
      "properties": {
        "operationId": { "type": "string", "format": "tid" },
        "requestHash": { "type": "string", "minLength": 64, "maxLength": 64, "description": "Lowercase hexadecimal SHA-256 of canonical request JSON." },
        "state": { "type": "string", "knownValues": ["queued", "running", "pending", "completed", "failed", "paused"] },
        "completedSteps": { "type": "array", "items": { "type": "string", "maxLength": 128 } },
        "error": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
